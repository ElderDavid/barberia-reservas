# Local development values. Every secret below is a fake placeholder that only works locally.
# Production values are set in the Vercel dashboard, never in this file.

# Postgres from docker-compose.yml (port 54329). Three databases: dev, integration tests, e2e.
DATABASE_URL=postgres://barberia:barberia@localhost:54329/barberia
TEST_DATABASE_URL=postgres://barberia:barberia@localhost:54329/barberia_test
E2E_DATABASE_URL=postgres://barberia:barberia@localhost:54329/barberia_e2e
# Production only: Supabase "session pooler" connection string used by `pnpm db:migrate`.
MIGRATION_DATABASE_URL=

# Public base URL of the app (links in manage pages, Wompi redirect, auth origin).
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-me-0123456789

# Owner account created by `pnpm db:seed` / `pnpm owner:create`.
OWNER_NAME=Dueño
OWNER_EMAIL=dueno@barberia.local
OWNER_PASSWORD=cambia-esta-clave-123

# Wompi (sandbox keys start with pub_test_ / test_). Placeholders work for local tests only.
WOMPI_PUBLIC_KEY=pub_test_local_placeholder
WOMPI_INTEGRITY_SECRET=test_integrity_local_placeholder
WOMPI_EVENTS_SECRET=test_events_local_placeholder

# Bearer token Vercel Cron sends to /api/cron/expire-holds.
CRON_SECRET=dev-only-cron-secret
